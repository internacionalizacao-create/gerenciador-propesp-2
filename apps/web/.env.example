# =============================================================================
# Web / BFF (Next.js). Copie para apps/web/.env.local e preencha:
#   cp apps/web/.env.example apps/web/.env.local
#
# Nenhuma variavel aqui tem prefixo NEXT_PUBLIC_ — todas sao lidas so no
# servidor. O build quebra se este arquivo for importado por um Client Component
# (src/lib/env.ts usa `server-only`).
# =============================================================================

APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# --- Keycloak (client confidencial `gerenciador-web`) ---
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/gerenciador
KEYCLOAK_CLIENT_ID=gerenciador-web
# Valor do realm de desenvolvimento (infra/keycloak/import/gerenciador-realm.json).
# Em qualquer outro ambiente, gere um segredo novo pelo console do Keycloak.
KEYCLOAK_CLIENT_SECRET=dev-web-secret-nao-use-em-producao

# --- Cookie de sessao ---
# 32 bytes em base64url. Gere o seu com:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Trocar este valor invalida todas as sessoes ativas.
SESSION_SECRET=troque-me-por-32-bytes-em-base64url
