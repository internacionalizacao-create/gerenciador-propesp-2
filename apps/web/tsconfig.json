{
  "compilerOptions": {
    // ES2020 pelo BigInt: `somarMoeda` soma dinheiro em centavos inteiros, e o
    // literal `0n` nao existe abaixo desse alvo. Node 24 e todo browser
    // suportado ja implementam BigInt ha anos.
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Permite `import ... from "./x.ts"`. O `node --test` do repositorio roda
    // TypeScript em modo strip-only e **exige** a extensao no import relativo,
    // enquanto o TS a recusa por padrao. Sem isto, um modulo `.ts` que importa
    // outro `.ts` nao pode ser testado — que e justamente o padrao adotado para
    // manter logica testavel fora dos `.tsx`. So e valido porque `noEmit` esta
    // ligado: nada aqui e compilado para disco pelo tsc.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
