# =============================================================================
# API (NestJS). Copie para apps/api/.env: cp apps/api/.env.example apps/api/.env
# O arquivo .env NAO e versionado. A API se recusa a subir se algo aqui faltar
# (validacao em src/config/env.ts).
# =============================================================================

NODE_ENV=development
PORT=3001

# --- Keycloak (resource server) ---
# Precisa bater EXATAMENTE com a claim `iss` dos tokens, inclusive o host.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/gerenciador

# clientId desta API no Keycloak. Todo access token tem que trazer isso em `aud`.
KEYCLOAK_AUDIENCE=gerenciador-api

# --- Banco de dados (Postgres da API, subido por `pnpm infra:up`) ---
DATABASE_URL=postgresql://gerenciador:gerenciador@localhost:5432/gerenciador
DATABASE_POOL_MAX=10

# Banco usado pelos testes de integracao. E RECRIADO A CADA RODADA — nunca
# aponte para o banco de desenvolvimento. So aceita loopback e o nome exato
# gerenciador_test, sem query/fragmento. CI usa Postgres 17 descartavel.
# Leitores exigidos: poppler-utils, unzip e libreoffice-calc.
TEST_DATABASE_URL=postgresql://gerenciador:gerenciador@localhost:5432/gerenciador_test
