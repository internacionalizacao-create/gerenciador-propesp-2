# =============================================================================
# Infra (Keycloak + Postgres). Copie para infra/.env: cp infra/.env.example infra/.env
# O arquivo infra/.env NÃO é versionado (veja .gitignore).
# =============================================================================

# --- Keycloak: usuário admin de bootstrap (console em http://localhost:8080) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Postgres do Keycloak (exposto em localhost:5433) ---
KEYCLOAK_DB_PASSWORD=keycloak

# --- Postgres da API (exposto em localhost:5432) ---
API_DB_NAME=gerenciador
API_DB_USER=gerenciador
API_DB_PASSWORD=gerenciador
